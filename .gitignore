# Build
**/target/
*.class
*.jar
!**/src/**/resources/**/*.jar
# Published convenience binaries (no proprietary JDBC)
!prebuilt/*.jar
!prebuilt/*.zip
*.o
*.so
*.a

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo
.classpath
.project
.settings/

# OS
.DS_Store
Thumbs.db

# Logs / runtime
*.log
*.pid
hs_err_pid*

# Local secrets and lab overrides (never commit)
dev/local.env
dev/*.local
config/*.properties
!config/*.properties.example
scripts/register.bteq.local
.env
.env.*

# Generated UDF registration
scripts/register.generated.bteq

# Local release staging (published copies live under prebuilt/)
/dist/

# Test outputs
testing/**/surefire-reports/
testing/**/stress_results*/
