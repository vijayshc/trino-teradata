<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.trino-teradata</groupId>
        <artifactId>trino-teradata-direct</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>trino-tdexport-tests</artifactId>
    <name>Trino Teradata Direct Integration Tests</name>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.9</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.4.11</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.trino</groupId>
            <artifactId>trino-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <trimStackTrace>false</trimStackTrace>
                    <!-- Integration tests need a live Trino+Teradata environment.
                         Skip by default on plain `mvn package`; enable with -DskipITs=false -->
                    <skipTests>${skipITs}</skipTests>
                    <systemPropertyVariables>
                        <trino.jdbc.url>${trino.jdbc.url}</trino.jdbc.url>
                        <trino.user>${trino.user}</trino.user>
                        <trino.server.log>${trino.server.log}</trino.server.log>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <skipITs>true</skipITs>
        <trino.jdbc.url>jdbc:trino://localhost:8080/tdexport/trinoexport</trino.jdbc.url>
        <trino.user>vijay</trino.user>
        <trino.server.log></trino.server.log>
    </properties>
</project>
