# Copy to dev/local.env and customize for your lab.
# scripts/*.sh source this file automatically when present.
#
#   cp dev/env.example dev/local.env

# --- Java / Maven ---
# JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# --- Trino cluster (local multi-node lab) ---
TRINO_HOME=/path/to/trino-server-479
TRINO_WORKER_1=/path/to/trino-worker-1
PLUGIN_NAME=teradata-export

# Proprietary Teradata JDBC driver (required at deploy time)
TERADATA_JDBC_JAR=/path/to/terajdbc4.jar

# --- Catalog connectivity (used only when generating catalog props) ---
TD_JDBC_URL=jdbc:teradata://YOUR_TD_HOST/DATABASE=DBC,TMODE=TERA
TD_USER=your_service_user
TD_PASSWORD=your_password
TD_UDF_DATABASE=TrinoExport

# Worker bridge addresses advertised to Teradata AMPs
# TRINO_ADVERTISED=10.0.0.1
# WORKER_ADVERTISED_ADDRESSES=10.0.0.1:9998,10.0.0.1:9999

# --- Integration tests ---
TRINO_JDBC_URL=jdbc:trino://localhost:8080/tdexport/trinoexport
TRINO_USER=your_trino_user
TRINO_SERVER_LOG=/path/to/trino-server/data/var/log/server.log

# --- UDF registration (BTEQ) ---
TD_HOST=YOUR_TD_HOST
TD_LOGON_USER=dbc
TD_LOGON_PASSWORD=dbc
UDF_SRC_DIR=  # defaults to <repo>/teradata-udf
